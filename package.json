{
  "name": "valiance-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:tax": "npx --yes tsx@4 scripts/verify-tax.ts",
    "test:accounting": "tsx scripts/verify-accounting.ts",
    "test:accounting:db": "tsx scripts/verify-accounting-db.ts",
    "test:accounting:workflows": "tsx scripts/verify-accounting-workflows.ts",
    "test:accounting:imports": "tsx scripts/verify-accounting-imports.ts && tsx scripts/verify-accounting-import-db.ts",
    "test:accounting:documents": "tsx scripts/verify-accounting-documents.ts",
    "test:accounting:close": "tsx scripts/verify-accounting-close.ts && tsx scripts/verify-accounting-clearing.ts && tsx scripts/verify-accounting-periods.ts",
    "test:accounting:schema": "tsx scripts/verify-accounting-schema.ts",
    "test:accounting:concurrency": "tsx scripts/verify-accounting-concurrency.ts",
    "test:accounting:http": "tsx scripts/verify-accounting-http.ts",
    "build:accounting": "tsx scripts/build-accounting.ts",
    "lint:accounting": "eslint --config eslint.accounting.config.mjs src/lib/accounting src/components/features/accounting src/app/api/accounting \"src/app/(dashboard)/accounting\" scripts/verify-accounting.ts scripts/verify-accounting-db.ts",
    "format:accounting": "prettier --write \"src/lib/accounting/**/*.ts\" \"src/components/features/accounting/**/*.{ts,tsx}\" \"src/app/(dashboard)/accounting/page.tsx\" \"src/app/api/accounting/**/*.ts\" \"scripts/*accounting*.ts\" eslint.accounting.config.mjs",
    "test:accounting:history": "tsx scripts/verify-accounting-history.ts && tsx scripts/verify-accounting-history-imports.ts",
    "test:accounting:transfers": "tsx scripts/verify-accounting-transfers.ts",
    "test:accounting:bank": "tsx scripts/verify-accounting-bank-matching.ts",
    "test:accounting:retained": "tsx scripts/verify-accounting-retained-review.ts",
    "test:accounting:statements": "tsx scripts/verify-accounting-statement-files.ts",
    "test:accounting:statement-http": "tsx scripts/verify-accounting-statement-http.ts",
    "test:accounting:rules": "tsx scripts/verify-accounting-rules.ts",
    "test:accounting:feeds": "tsx scripts/verify-accounting-simplefin.ts && tsx scripts/verify-accounting-feed-db.ts && tsx scripts/verify-accounting-feed-sync.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.535.0",
    "next": "^16.1.6",
    "nodemailer": "^7.0.12",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
